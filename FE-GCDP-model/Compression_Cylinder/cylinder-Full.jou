reset

## Geometry parameters - height and radius
#{h = 300}
#{r = 75}

## Desired element size and optionally intervals
#{el_s = 6}
#{h_n = ceil(h/(2*el_s))}
#{r_n = ceil(r/el_s)}
#{r_O = ceil(r/el_s)}
#{TOL = 0.01}
create Cylinder height {h} radius {r} 

webcut volume all with plane xplane

volume {Id("volume") - 0} name "left_x"
volume {Id("volume") - 1} name "right_x"

surface 7 name "bottom_right_y"
surface 6 name "outer_right"
surface 5 name "top_right_y"

surface 9 name "bottom_left_y"
surface 10 name "outer_left"
surface 11 name "top_left_y"

imprint all
merge all

## ------------------------------------------------------------
## Mesh left half
## ------------------------------------------------------------

curve in surface with name "top_left_y" with (x_coord < {0+TOL} and x_coord > {0-TOL}) interval {r_n}
curve in surface with name "top_left_y" with (x_coord < {-r/2-TOL}) interval {r_O}

mesh surface with name "top_left_y"

volume with name "left_x" redistribute nodes on size {el_s}
volume with name "left_x" scheme Sweep source surface with name "top_left_y" target surface with name "bottom_left_y" sweep transform translate propagate bias
mesh volume with name "left_x"

## ------------------------------------------------------------
## Mesh right half
## ------------------------------------------------------------

curve in surface with name "top_right_y" with (x_coord < {0+TOL} and x_coord > {0-TOL}) interval {r_n}
curve in surface with name "top_right_y" with (x_coord > {r/2-TOL}) interval {r_O}

mesh surface with name "top_right_y"

volume with name "right_x" redistribute nodes on size {el_s}
volume with name "right_x" scheme Sweep source surface with name "top_right_y" target surface with name "bottom_right_y" sweep transform translate propagate bias
mesh volume with name "right_x"

################################################################# REFINE MESH
create group "refineConcrete"
#{refineConcrete_gId = Id("group")}

create group "refineRegion"
#{refineRegion_gId = Id("group")}
group refineRegion add hex with z_coord< {h/8-TOL} and z_coord> {-h/8+TOL} in volume all
group refineConcrete add hex in refineRegion

refine hex in group refineConcrete

## ------------------------------------------------------------
## Blocks / material regions
## ------------------------------------------------------------

group "weak_hexes" add hex with (x_coord > {-r/20-TOL} and x_coord < {r/20+TOL} and y_coord > {-r/20-TOL} and y_coord < {r/20+TOL} and z_coord > {-h/60-TOL} and z_coord < {h/60+TOL})

group "concrete_hexes" add hex with (x_coord <= {-r/20-TOL} or x_coord >= {r/20+TOL} or y_coord <= {-r/20-TOL} or y_coord >= {r/20+TOL} or z_coord <= {-h/60-TOL} or z_coord >= {h/60+TOL})

create block 1
block 1 name "all_els"
block 1 add group with name "concrete_hexes"
block 1 element type hex20

create block 2
block 2 name "weak_region"
block 2 add group with name "weak_hexes"
block 2 element type hex20

list block

## ------------------------------------------------------------
## Nodesets
## ------------------------------------------------------------
create nodeset {NumNodesets()+1}
nodeset {NumNodesets()} name "top_z"
nodeset {NumNodesets()} add node in surface with name "top_right_y"
nodeset {NumNodesets()} add node in surface with name "top_left_y"

create nodeset {NumNodesets()+1}
nodeset {NumNodesets()} name "bottom_z"
nodeset {NumNodesets()} add node in surface with name "bottom_right_y"
nodeset {NumNodesets()} add node in surface with name "bottom_left_y"

create nodeset {NumNodesets()+1}
nodeset {NumNodesets()} name "outer"
nodeset {NumNodesets()} add node in surface with name "outer_left"
nodeset {NumNodesets()} add node in surface with name "outer_right"

create nodeset {NumNodesets()+1}
nodeset {NumNodesets()} name "bottom_middle_nodes"
nodeset {NumNodesets()} add node in surface with name "bottom_right_y" with (x_coord > {-r/20-TOL} and x_coord < {r/20+TOL} and y_coord > {-r/20-TOL} and y_coord < {r/20+TOL} and z_coord < {-h/2+TOL})

create nodeset {NumNodesets()+1}
nodeset {NumNodesets()} name "top_middle_nodes"
nodeset {NumNodesets()} add node in surface with name "top_right_y" with (x_coord > {-r/20-TOL} and x_coord < {r/20+TOL} and y_coord > {-r/20-TOL} and y_coord < {r/20+TOL} and z_coord > {h/2-TOL})

create nodeset {NumNodesets()+1}
nodeset {NumNodesets()} name "nudge_top_right"
nodeset {NumNodesets()} add node in surface with name "top_right_y" with (x_coord > {r-TOL} and y_coord > {-TOL} and y_coord < {+TOL} and z_coord > {h/2-TOL})

## ------------------------------------------------------------
## Export
## ------------------------------------------------------------

export abaqus "mesh_cylinder_coarse20.inp" overwrite partial

quality volume all scaled jacobian global draw histogram draw mesh
